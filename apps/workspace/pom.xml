<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fun.fengwk.kk-studio</groupId>
        <artifactId>kk-studio-parent</artifactId>
        <version>1.2.7</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>kk-studio-workspace</artifactId>

    <dependencies>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-common</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-platform-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-work</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-canvas-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-schema</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-workspace-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.workspace.ChatSpaceService</include>
                                        <include>fun.fengwk.kkstudio.workspace.WorkspacePlacements</include>
                                        <include>fun.fengwk.kkstudio.workspace.WorkspaceResourceOwnership</include>
                                        <include>fun.fengwk.kkstudio.workspace.WorkspaceInput</include>
                                        <include>fun.fengwk.kkstudio.workspace.ThreadStatus</include>
                                        <include>fun.fengwk.kkstudio.workspace.ScheduleTiming</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
