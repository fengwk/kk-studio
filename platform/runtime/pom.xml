<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.fengwk.kk-studio</groupId>
        <artifactId>kk-studio-platform</artifactId>
        <version>5.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kk-studio-platform-runtime</artifactId>

    <dependencies>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-platform-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- MCP client 与传输实现，只由 catalog.mcp.client 使用。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
        </dependency>
        <!--
            Jackson 2 只用于 MCP SDK 边界：McpToolResultExtractor 的签名固定接收
            com.fasterxml.jackson.databind.JsonNode，因此只有 McpResultExtractor 直接依赖它。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-share</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-agent-builtin</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-environment</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-model</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-schema</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-infra</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-agent-builtin</artifactId>
            <version>${kk-studio.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-runtime</artifactId>
            <version>${kk-studio.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.convention4j</groupId>
            <artifactId>convention4j-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.convention4j</groupId>
            <artifactId>convention4j-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <!-- Spring/PostgreSQL 测试基座供上层应用模块（Canvas、Project）的集成测试复用。 -->
                    <execution>
                        <id>platform-test-support</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>kk-studio-platform-runtime</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-critical-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.client</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.McpToolNameNormalizer</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.environment.gateway.EnvironmentDaemonGateway</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.read.TextReadWindow</include>
                                        <include>fun.fengwk.kkstudio.platform.settings.HttpProxySelector*</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.thread.command.DatabaseTurnResolver</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.model.ProviderResourceMaterializer*</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.model.ProviderInlineBlobReader*</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.tool.gateway.ToolExecutionGateway</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.tool.gateway.ToolExecutionGateway.GatewayRun</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.tool.PluginRuntimeToolCatalogSource*</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.tool.FrozenToolBindingVerifier</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.discovery.McpInputSchemaConverter</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.discovery.McpToolDiscovery</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.McpConfigParser</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.McpServerService</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.runtime.McpToolCatalog</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.runtime.RemoteMcpExecutableTool</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.resource.PublicAddressPolicy</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.resource.PublicAddressDnsResolver</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.resource.HttpRemoteMediaTransport</include>
                                        <include>fun.fengwk.kkstudio.platform.persistence.PostgresqlPersistenceConfiguration</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.configsync.ConfigSync*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Plugin 配置、凭据、目录快照与管理面的类级覆盖率门禁。 -->
                        <id>check-plugin-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.catalog.PluginCatalogSnapshot*</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.catalog.PluginCatalogRuntime*</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.persistence.*</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.credential.DatabasePluginCredentialStore</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.credential.FixedPluginCredentialAccess</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.credential.PluginCredentialRefreshService</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.credential.ScopedPluginCredentialAccess</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.service.PluginConfigurationService*</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.service.PluginManagementService*</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.service.PluginContextFactory</include>
                                        <include>fun.fengwk.kkstudio.platform.pluginhost.service.PluginSecretPatch</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
