    <build>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>kk-studio-platform-runtime</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-critical-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.McpToolNameNormalizer</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.environment.gateway.EnvironmentDaemonGateway</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.thread.command.DatabaseTurnResolver</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.model.ProviderResourceMaterializer*</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.model.ProviderInlineBlobReader*</include>
                                        <include>fun.fengwk.kkstudio.platform.harness.tool.gateway.ToolExecutionGateway</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.discovery.McpInputSchemaConverter</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.discovery.McpToolDiscovery</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.service.McpConfigParser</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.service.McpServerMutationValidator</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.service.impl.McpServerServiceImpl</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.runtime.McpToolCatalog</include>
                                        <include>fun.fengwk.kkstudio.platform.catalog.mcp.runtime.RemoteMcpExecutableTool</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.resource.PublicAddressPolicy</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.resource.PublicAddressDnsResolver</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.resource.HttpRemoteMediaTransport</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.catalog.PluginCatalogSnapshot*</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.credential.ScopedPluginCredentialAccess</include>
                                        <include>fun.fengwk.kkstudio.platform.persistence.PostgresqlPersistenceConfiguration</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.configsync.ConfigSync*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- 配置版本、完整目录与恢复逻辑的定向覆盖率门禁。 -->
                        <id>check-plugin-configuration-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.plugin.catalog.PluginCatalogSnapshot*</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.catalog.PluginCatalogBootstrap</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.catalog.PluginCatalogFingerprint</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.catalog.PluginCatalogManifest*</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.catalog.PluginCatalogRecord</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.PluginConfigurationRow</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.postgresql.PostgresqlPluginConfigurationRepository</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.postgresql.PostgresqlPluginCatalogChangeNotifier</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.postgresql.store.PluginConfigurationJdbcStore</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- S3-B2 秘密与配置管理的定向覆盖率门禁：唯一提交入口、管理面用例、候选上下文与 attempt 单次消费。 -->
                        <id>check-plugin-secret-management-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.plugin.service.PluginConfigurationCommitService</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.service.PluginManagementService</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.service.PluginConfigurationHistory</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.service.PluginContextFactory</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.service.PluginAuthNonce</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.service.PluginSecretPatch</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.credential.FixedPluginCredentialAccess</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.catalog.PluginAuthContextFingerprint</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.PluginAuthAttemptRow</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.postgresql.PostgresqlPluginAuthAttemptRepository</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.postgresql.store.PluginAuthAttemptJdbcStore</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- 凭据认证代际与共享 crypto 原语的定向覆盖率门禁。 -->
                        <id>check-plugin-credential-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.platform.crypto.AesGcmEnvelope</include>
                                        <include>fun.fengwk.kkstudio.platform.crypto.LengthPrefixedAad</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.credential.PluginCredentialCodec</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.credential.DatabasePluginCredentialStore</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.credential.PluginCredentialRefreshService</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.credential.ScopedPluginCredentialAccess</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.PluginCredentialRow</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.postgresql.PostgresqlPluginCredentialRepository</include>
                                        <include>fun.fengwk.kkstudio.platform.plugin.persistence.postgresql.store.PluginCredentialJdbcStore</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
