{
  "provider": {
    "models": {
      "nested-not": {
        "cost": {
          "text": { "input": { "price": 1 }, "output": { "price": 2 } },
          "multipliers": [
            { "when": { "not": { "region": { "equals": "us" } } }, "factor": 1.5 }
          ]
        }
      },
      "mixed-all": {
        "cost": {
          "text": { "input": { "price": 1 }, "output": { "price": 2 } },
          "multipliers": [
            {
              "when": { "all": [{ "service_tier": { "equals": "priority" } }, { "region": { "in": ["us", "eu"] } }] },
              "factor": 1.2
            }
          ]
        }
      },
      "mixed-any": {
        "cost": {
          "text": { "input": { "price": 1 }, "output": { "price": 2 } },
          "multipliers": [
            {
              "when": { "any": [{ "region": { "equals": "us" } }, { "date": { "gte": "2026-01-01" } }] },
              "factor": 1.3
            }
          ]
        }
      },
      "mixed-top-level": {
        "cost": {
          "text": { "input": { "price": 1 }, "output": { "price": 2 } },
          "multipliers": [
            {
              "when": { "service_tier": { "equals": "priority" }, "region": { "equals": "us" } },
              "factor": 1.4
            }
          ]
        }
      },
      "region-unknown-condition": {
        "cost": {
          "multipliers": [
            {
              "when": { "region": { "equals": "us" }, "unknown_key": { "equals": "foo" } },
              "factor": 1.1
            }
          ]
        }
      },
      "region-unknown-clause": {
        "cost": {
          "multipliers": [
            { "when": { "region": { "unknown_op": "us" } }, "factor": 1.1 }
          ]
        }
      },
      "region-not-unknown": {
        "cost": {
          "multipliers": [
            { "when": { "not": { "region": { "unknown_op": "us" } } }, "factor": 1.1 }
          ]
        }
      },
      "region-negative-factor": {
        "cost": {
          "multipliers": [
            { "when": { "region": { "equals": "us" } }, "factor": { "text": -1.1 } }
          ]
        }
      },
      "region-unknown-factor-field": {
        "cost": {
          "multipliers": [
            { "when": { "region": { "equals": "us" } }, "factor": { "video": 1.5 } }
          ]
        }
      },
      "region-invalid-factor-string": {
        "cost": {
          "multipliers": [
            { "when": { "region": { "equals": "us" } }, "factor": "invalid" }
          ]
        }
      },
      "region-context-conflict": {
        "cost": {
          "multipliers": [
            {
              "when": { "region": { "equals": "us" }, "context": { "gt": 100, "gte": 100 } },
              "factor": 1.1
            }
          ]
        }
      },
      "region-factor-scale-overflow": {
        "cost": {
          "multipliers": [
            { "when": { "region": { "equals": "us" } }, "factor": { "text": 1.0000000000000000001 } }
          ]
        }
      },
      "region-input-override": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [{ "when": { "region": { "equals": "us" } }, "price": 2 }]
            },
            "output": { "price": 2 }
          }
        }
      },
      "region-output-override": {
        "cost": {
          "text": {
            "input": { "price": 1 },
            "output": {
              "price": 2,
              "overrides": [{ "when": { "region": { "equals": "us" } }, "price": 3 }]
            }
          }
        }
      },
      "region-nested-override": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [{ "when": { "not": { "region": { "equals": "us" } } }, "price": 2 }]
            },
            "output": { "price": 2 }
          }
        }
      }
    }
  }
}
