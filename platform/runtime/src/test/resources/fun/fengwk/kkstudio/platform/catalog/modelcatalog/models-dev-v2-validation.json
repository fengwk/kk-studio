{
  "validation": {
    "id": "validation",
    "models": {
      "capable": {
        "id": "capable",
        "name": "Capable Model",
        "limit": { "context": 128000, "output": 8192 },
        "capabilities": { "tools": false, "reasoning": true },
        "modalities": { "input": ["text", "image", "application/pdf", "unknown"] },
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "unit": "per_million",
              "cache": { "read": 0.1, "write": 0.2 }
            },
            "output": { "price": 2, "reasoning": 0 }
          }
        }
      },
      "missing-capabilities": {
        "cost": { "text": { "input": { "price": 1 }, "output": { "price": 2 } } }
      },
      "no-cost": {},
      "null-prices": {
        "cost": { "text": { "input": { "price": null }, "output": {} } }
      },
      "missing-input": {
        "cost": { "text": { "output": { "price": 2 } } }
      },
      "missing-output": {
        "cost": { "text": { "input": { "price": 1 } } }
      },
      "audio-cost": {
        "cost": {
          "audio": { "price": 5 },
          "text": { "input": { "price": 1 }, "output": { "price": 2 } }
        }
      },
      "cache-flags": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "cache": { "read": 1, "write": 2, "explicit": true, "storage": 3 }
            },
            "output": { "price": 2 }
          }
        }
      },
      "unknown-input": {
        "cost": { "text": { "input": { "price": 1, "foo": 2 }, "output": { "price": 2 } } }
      },
      "output-override-no-reasoning": {
        "cost": {
          "text": {
            "input": { "price": 1 },
            "output": {
              "price": 2,
              "overrides": [{ "when": { "context": { "gte": 100 } }, "price": 3 }]
            }
          }
        }
      },
      "date-gte-only": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [{ "when": { "date": { "gte": "2026-01-01" } }, "price": 2 }]
            },
            "output": { "price": 2 }
          }
        }
      },
      "date-lt-only": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [{ "when": { "date": { "lt": "2027-01-01" } }, "price": 2 }]
            },
            "output": { "price": 2 }
          }
        }
      },
      "service-tier-in": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [
                { "when": { "service_tier": { "in": ["priority", "flex"] } }, "price": 2 }
              ]
            },
            "output": { "price": 2 }
          }
        }
      },
      "utc-days-equals": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [
                {
                  "when": { "utc_days": { "equals": "mon" }, "utc_hours": { "gte": "01:00" } },
                  "price": 2
                }
              ]
            },
            "output": { "price": 2 }
          }
        }
      },
      "ttl-days": {
        "cost": {
          "text": {
            "input": { "price": 1, "cache": { "read": 1, "write": { "1d": 4 } } },
            "output": { "price": 2 }
          }
        }
      },
      "multiplier-audio": {
        "cost": {
          "multipliers": [{ "when": {}, "factor": { "audio": { "price": 2 } } }],
          "text": { "input": { "price": 1 }, "output": { "price": 2 } }
        }
      },
      "unknown-condition-nested": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [{ "when": { "context": { "between": 1 } }, "price": 2 }]
            },
            "output": { "price": 2 }
          }
        }
      },
      "unknown-override-field": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [{ "when": {}, "price": 2, "note": "x" }]
            },
            "output": { "price": 2 }
          }
        }
      },
      "unknown-factor-field": {
        "cost": {
          "multipliers": [{ "when": {}, "factor": { "image": { "price": 2 } } }],
          "text": { "input": { "price": 1 }, "output": { "price": 2 } }
        }
      },
      "override-order": {
        "cost": {
          "text": {
            "input": {
              "price": 10,
              "overrides": [
                { "when": { "context": { "gt": 100 } }, "price": 1 },
                { "when": { "context": { "gte": 200 } }, "price": 2 },
                { "when": { "context": { "gt": 100 } }, "cache": { "read": 3 } }
              ]
            },
            "output": { "price": 20 }
          }
        }
      },
      "context-conflict": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [
                { "when": { "context": { "gt": 100, "gte": 100 } }, "price": 2 }
              ]
            },
            "output": { "price": 2 }
          }
        }
      },
      "not-null": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [{ "when": { "not": null }, "price": 2 }]
            },
            "output": { "price": 2 }
          }
        }
      },
      "ttl-overflow": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "cache": { "write": { "9223372036854775807h": 1 } }
            },
            "output": { "price": 2 }
          }
        }
      },
      "precision-overflow": {
        "cost": {
          "text": {
            "input": { "price": 1.1111111111111111111111111111111111111111111111111111111111111111111111 },
            "output": { "price": 2 }
          }
        }
      },
      "utc-hours-lt-midnight": {
        "cost": {
          "text": {
            "input": {
              "price": 1,
              "overrides": [
                { "when": { "utc_hours": { "gte": "22:00", "lt": "00:00" } }, "price": 2 }
              ]
            },
            "output": { "price": 2 }
          }
        }
      },
      "scalar-multiplier": {
        "cost": {
          "multipliers": [{ "when": { "context": { "gt": 100 } }, "factor": 1.25 }],
          "text": { "input": { "price": 2 }, "output": { "price": 4 } }
        }
      }
    }
  }
}
