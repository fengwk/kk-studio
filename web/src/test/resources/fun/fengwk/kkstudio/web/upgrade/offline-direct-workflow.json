{
  "id": "offline-direct-video",
  "description": "offline direct video workflow",
  "strategy": "DIRECT",
  "workflowJson": "{\"1\":{\"class_type\":\"LoadImage\",\"inputs\":{\"image\":\"placeholder\"}},\"2\":{\"class_type\":\"PrimitiveString\",\"inputs\":{\"value\":\"placeholder\"}},\"3\":{\"class_type\":\"PrimitiveInt\",\"inputs\":{\"value\":0}},\"4\":{\"class_type\":\"SaveVideo\",\"inputs\":{\"filename_prefix\":\"out\",\"videos\":[\"5\",0]}}}",
  "argsSchemaJson": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"prompt\":{\"type\":\"string\"},\"duration\":{\"type\":\"integer\"}},\"required\":[\"prompt\"]}",
  "parameterBindings": [
    {"argument": "prompt", "nodeId": "2", "input": "value"},
    {"argument": "duration", "nodeId": "3", "input": "value"}
  ],
  "mediaBindings": [
    {"referenceIndex": 0, "nodeId": "1", "input": "image"}
  ],
  "outputs": [
    {"kind": "VIDEO", "nodeId": "4", "field": "videos", "index": 0}
  ],
  "referencePolicy": {
    "allowedKinds": ["IMAGE"],
    "maxCount": 1,
    "maxCountByKind": [{"kind": "IMAGE", "maxCount": 1}]
  }
}
