# VCS metadata and local agent workspaces
.git/
.gitignore
.gitattributes
.workspace/

# Maven build outputs. Only the host-built Fat JAR is allowed into the context
# (see deploy/local/Dockerfile); everything else under target/ is excluded.
**/target/
!web/target/
web/target/**
!web/target/kk-studio-web-1.0.0.jar
**/.mvn/wrapper/maven-wrapper.jar

# Frontend caches / outputs (embedded into the Fat JAR by host distribution build)
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Local reports and artifacts (never required for build)
reports/

# IDE / editor
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.metadata
.factorypath

# OS noise and logs
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.log
*.pid

# Local secrets / credentials (must never reach the image)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
credentials*
service-account*.json
secrets/

# Archives that should never be part of the build context
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
