[
  {
    "name": "assistant_abort_closure",
    "events": [
      {
        "eventType": "assistant_start",
        "payload": {
          "userMessages": ["hello"]
        }
      },
      {
        "eventType": "assistant_delta",
        "payload": {
          "textDelta": "partial"
        }
      },
      {
        "eventType": "abort",
        "payload": {
          "reason": "stopped"
        }
      }
    ],
    "expected": {
      "messages": [
        {
          "type": "user",
          "text": "hello"
        },
        {
          "type": "ai",
          "text": "partial\nstopped",
          "toolCalls": []
        }
      ]
    }
  },
  {
    "name": "tool_error_closure",
    "events": [
      {
        "eventType": "tool_start",
        "payload": {
          "toolCallId": "call_1",
          "toolName": "bash",
          "arguments": "{}"
        }
      },
      {
        "eventType": "tool_delta",
        "payload": {
          "toolCallId": "call_1",
          "contentDeltas": [
            {
              "index": 0,
              "contentDelta": {
                "type": "text",
                "text": "partial"
              }
            }
          ]
        }
      },
      {
        "eventType": "error",
        "payload": {
          "toolCallId": "call_1",
          "message": "tool failed"
