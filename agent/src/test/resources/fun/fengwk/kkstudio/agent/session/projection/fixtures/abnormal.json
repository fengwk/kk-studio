    "expected": {
      "messages": [
        {
          "type": "tool",
          "id": "call_1",
          "toolName": "bash",
          "contents": [
            {
              "type": "text",
              "text": "partial\ntool failed"
            }
          ]
        }
      ]
    }
  },
