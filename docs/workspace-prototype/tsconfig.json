{
  "extends": "../../frontend/tsconfig.app.json",
  "compilerOptions": {
    "baseUrl": "../../frontend",
    "paths": {
      "@/*": ["src/*"],
      "@preview-original-turn-footer": ["src/features/thread/runtime/thread-panel/messages/MetaMessageBlock.tsx"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "react-router": ["node_modules/react-router/dist/production/index.d.ts"],
      "*": ["node_modules/*"]
    },
    "allowJs": true,
    "types": ["../../frontend/node_modules/vite/client"]
  },
  "include": ["start.ts"]
}
