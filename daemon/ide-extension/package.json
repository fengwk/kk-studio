{
  "name": "kk-studio-ide-bridge",
  "displayName": "KK Studio IDE Bridge",
  "description": "Connects a managed code-server window to the KK Studio daemon for directory switching and terminal focus.",
  "publisher": "kk-studio",
  "version": "2.0.1",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.cjs",
  "activationEvents": ["*"],
  "contributes": {
    "configurationDefaults": {
      "workbench.colorTheme": "Dark Modern",
      "window.density.editorTabHeight": "compact",
      "chat.disableAIFeatures": true,
      "extensions.ignoreRecommendations": true,
      "files.watcherExclude": { "**": true },
      "task.autoDetect": "off",
      "npm.autoDetect": "off",
      "npm.fetchOnlinePackageInfo": false,
      "typescript.disableAutomaticTypeAcquisition": true
    }
  }
}
