{
  "name": "@kk-studio/daemon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate:control": "node ../platform/daemon-server/src/main/protocol/ts/generate.mjs",
    "check:control": "node ../platform/daemon-server/src/main/protocol/ts/generate.mjs --check",
    "golden:control": "node scripts/write-control-golden.mjs",
    "test": "npm run build && vitest run",
    "coverage": "npm run build && vitest run --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@vscode/ripgrep": "1.18.0",
    "diff": "9.0.0",
    "isomorphic-git": "1.43.3",
    "jsonc-parser": "3.3.1",
    "koffi": "3.3.3",
    "undici": "8.11.2",
    "vscode-jsonrpc": "9.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
