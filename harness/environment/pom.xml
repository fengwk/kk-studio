<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.fengwk.kk-studio</groupId>
        <artifactId>kk-studio-harness</artifactId>
        <version>1.0.11</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kk-studio-harness-environment</artifactId>

    <dependencies>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-common</artifactId>
        </dependency>
        <!-- daemon wire 直接使用共享 carrier 的单条逻辑消息预算（NotificationLimits）作为唯一事实来源。 -->
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-share</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-critical-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun/fengwk/kkstudio/harness/environment/capability/EnvironmentCapabilityCatalog</include>
                                        <include>fun/fengwk/kkstudio/harness/environment/daemon/DaemonEnvelopeCodec</include>
                                        <include>fun/fengwk/kkstudio/harness/environment/terminal/TerminalViewUpdate</include>
                                        <include>fun/fengwk/kkstudio/harness/environment/terminal/TerminalViewUpdateCodec</include>
                                        <include>fun/fengwk/kkstudio/harness/environment/terminal/TerminalLimits</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <!-- 控制协议 codec 与不可变模型按包聚合行覆盖率，避免对记录 boilerplate 逐类机械门禁。 -->
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>fun/fengwk/kkstudio/harness/environment/terminal</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
