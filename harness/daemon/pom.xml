<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.fengwk.kk-studio</groupId>
        <artifactId>kk-studio-harness</artifactId>
        <version>1.0.10</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kk-studio-harness-daemon</artifactId>

    <properties>
        <!-- 标准 Java LSP 客户端（JSON-RPC 分帧与协议模型）。 -->
        <lsp4j.version>1.0.0</lsp4j.version>
        <!-- 执行范围的原生边界：POSIX setsid/kill 与 Windows Job Object/CreateProcessW。 -->
        <jna.version>5.19.1</jna.version>
        <!-- 伪终端（PTY / ConPTY）支持：交互式终端 stdio 模式。 -->
        <pty4j.version>0.14.0</pty4j.version>
        <!-- SLF4J：pty4j 与 JGit 以 SLF4J 记录诊断，绑定固定为 nop，避免无绑定告警污染用户终端（PTY 模式下 stderr 就是终端）。 -->
        <slf4j.version>2.0.19</slf4j.version>
        <!-- headless VT 内核唯一实现：JediTerm 核心；上游双许可，本项目选择 Apache-2.0。 -->
        <jediterm.version>3.76</jediterm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 对齐 SLF4J：JGit 传递 2.0.18、pty4j 声明 2.0.19，这里统一为 2.0.19，使 nop 绑定与 API 同版本。 -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!-- JediTerm 只发布在 JetBrains 仓库，Central 不提供该构件。 -->
        <repository>
            <id>jetbrains-intellij-dependencies</id>
            <url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-share</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.re2j</groupId>
            <artifactId>re2j</artifactId>
            <version>1.8</version>
        </dependency>
        <!-- 标准 Java LSP 客户端：JSON-RPC 分帧、协议模型与请求分发。 -->
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
            <version>${lsp4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j.jsonrpc</artifactId>
            <version>${lsp4j.version}</version>
        </dependency>
        <!-- OS 执行范围：JNA 直接提供 POSIX 进程组与 Windows Job Object 的原生调用，无需本地 C 编译器。 -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>
        <!-- 伪终端：交互终端 stdio 模式（PTY）在 Linux/macOS 用 pty4j 原生库，在 Windows 用 ConPTY。 -->
        <dependency>
            <groupId>org.jetbrains.pty4j</groupId>
            <artifactId>pty4j</artifactId>
            <version>${pty4j.version}</version>
        </dependency>
        <!-- headless VT 内核：JediTerm 核心提供终端解释与缓冲模型，是唯一解析实现（不新增第二解析器）。 -->
        <dependency>
            <groupId>org.jetbrains.jediterm</groupId>
            <artifactId>jediterm-core</artifactId>
            <version>${jediterm.version}</version>
        </dependency>
        <!-- pty4j 以 SLF4J 记录诊断；绑定固定为 nop，避免「没有 provider」告警混进用户终端（PTY 模式下 stderr 就是终端）。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-environment</artifactId>
        </dependency>
        <dependency>
            <!-- 仅测试作用域：daemon 与真实 EnvironmentDaemonServer 的协议桥接集成测试；生产 main 绝不依赖 server 包。 -->
            <groupId>fun.fengwk.kk-studio</groupId>
            <artifactId>kk-studio-harness-environment-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 主产物是唯一可分发的单文件 Daemon：所有 runtime 依赖都内嵌其中。 -->
        <finalName>kk-studio-daemon</finalName>

        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-terminal-kernel-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <!-- 核心新包：headless VT 内核与画面投影按包聚合行覆盖率。 -->
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>fun/fengwk/kkstudio/harness/daemon/terminal</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>shade-standalone-daemon</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 不生成 dependency-reduced-pom：依赖声明保持与源码一致。 -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- 签名与索引元数据在合并后必然失效，必须移除。 -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/INDEX.LIST</exclude>
                                        <!-- 交付声明只由下面的 IncludeResourceTransformer 追加一份；留在这里会让「重复 verify」时的输入
                                             （上一轮已经打包好声明的 jar）与本轮的声明撞成 duplicate entry。 -->
                                        <exclude>META-INF/THIRD_PARTY_NOTICES</exclude>
                                        <exclude>META-INF/licenses/jediterm/LICENSE-APACHE-2.0.txt</exclude>
                                        <!-- 多份 module-info 合并会互相覆盖；Daemon 运行在 unnamed module 中。 -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- 合并各依赖的 META-INF/services，保留 JDK 服务发现。 -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- 合并 Apache 组件的 NOTICE / NOTICE.txt，避免单文件打包覆盖声明。 -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <projectName>kk-studio Environment Daemon</projectName>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/THIRD_PARTY_NOTICES</resource>
                                    <file>${project.basedir}/THIRD_PARTY_NOTICES</file>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/licenses/jediterm/LICENSE-APACHE-2.0.txt</resource>
                                    <file>${project.basedir}/../../LICENSE</file>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Main-Class>fun.fengwk.kkstudio.harness.daemon.DaemonMain</Main-Class>
                                        <Implementation-Title>kk-studio-daemon</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <!-- 依赖携带 META-INF/versions 多版本类，必须声明。 -->
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
