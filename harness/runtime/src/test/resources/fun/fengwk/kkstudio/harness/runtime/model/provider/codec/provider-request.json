  "messages": [
    {"role": "SYSTEM", "contents": [{"type": "text", "text": "You are a careful assistant."}]},
    {"role": "USER", "contents": [
      {"type": "text", "text": "What is the capital of France?"},
      {"type": "image", "mediaType": "image/png", "source": "data:image/png;base64,AAA"},
      {"type": "audio", "mediaType": "audio/wav", "source": "https://example.test/audio.wav"},
      {"type": "video", "mediaType": "video/mp4", "source": "https://example.test/video.mp4"},
      {"type": "thinking", "thinking": "the user asks geography"},
      {"type": "json", "json": "{\n  \"hint\":\"capital\"\n}"}
    ]},
    {"role": "ASSISTANT", "contents": [
