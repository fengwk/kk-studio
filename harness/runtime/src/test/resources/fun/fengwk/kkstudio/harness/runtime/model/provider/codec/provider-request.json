      {"type": "text", "text": "Let me look that up."}
    ]},
    {"role": "TOOL", "contents": [
      {"type": "tool_result", "toolCallId": "call-1", "toolName": "lookup", "contents": [{"type": "text", "text": "Paris"}], "error": false, "detailsJson": "{\n  \"lat\":48.85\n}"}
    ]},
    {"role": "ASSISTANT", "contents": [{"type": "text", "text": "The capital of France is Paris."}]}
  ],
  "tools": [
    {
