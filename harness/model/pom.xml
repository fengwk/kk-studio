<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.fengwk.kk-studio</groupId>
        <artifactId>kk-studio-harness</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kk-studio-harness-model</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-critical-class-line-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.ProviderErrorHelper</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.ProviderJsonHelper</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.ProviderMediaValidator</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.RequestBodySizeGuard</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.ProviderStreamBridge</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.ProviderModelDiscovery</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.transport.JdkHttpSseTransport</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.ProviderSseCall</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.transport.IncrementalSseParser</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.transport.TransportException</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.anthropic.AnthropicEndpoints</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.anthropic.AnthropicEncodedRequest</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.anthropic.AnthropicRequestEncoder</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.anthropic.AnthropicStreamAccumulator</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.anthropic.AnthropicErrorMapper</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.anthropic.AnthropicModelProvider</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.anthropic.AnthropicProviderAdapter</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.gemini.GeminiEndpoints</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.gemini.GeminiEncodedRequest</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.gemini.GeminiRequestEncoder</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.gemini.GeminiStreamAccumulator</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.gemini.GeminiErrorMapper</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.gemini.GeminiModelProvider</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.gemini.GeminiProviderAdapter</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.chat.OpenAiChatEndpoints</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.chat.OpenAiChatEncodedRequest</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.chat.OpenAiChatRequestEncoder</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.chat.OpenAiChatStreamAccumulator</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.chat.OpenAiChatErrorMapper</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.chat.OpenAiChatModelProvider</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.chat.OpenAiChatProviderAdapter</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.responses.OpenAiResponsesEndpoints</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.responses.OpenAiResponsesEncodedRequest</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.responses.OpenAiResponsesRequestEncoder</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.responses.OpenAiResponsesStrictSchema</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.responses.OpenAiResponsesStreamAccumulator</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.responses.OpenAiResponsesErrorMapper</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.responses.OpenAiResponsesModelProvider</include>
                                        <include>fun.fengwk.kkstudio.harness.model.provider.impl.openai.responses.OpenAiResponsesProviderAdapter</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
